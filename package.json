{
  "name": "inout",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "deploy": "pnpm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply inout-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply inout-db --remote",
    "dev:worker": "wrangler dev --local --ip 0.0.0.0",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/workers/tsconfig.json",
    "skills:list": "intent list",
    "skills:install": "intent install",
    "preinstall": "node scripts/require-pnpm.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.47",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@tanstack/router-cli": "^1.167.45",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1",
    "@tanstack/intent": "^0.5.5"
  },
  "engines": {
    "node": "^24.15.0",
    "pnpm": "^12.11.2"
  },
  "packageManager": "pnpm@12.11.2",
  "intent": {
    "skills": [
      "@tanstack/react-start",
      "@tanstack/start-client-core",
      "@tanstack/start-server-core",
      "@tanstack/router-core",
      "@tanstack/router-plugin",
      "@tanstack/virtual-file-routes"
    ]
  }
}
