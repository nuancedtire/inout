{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inout",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inout-db",
      "database_id": "bf2c7aa1-8fe5-4c82-a2fd-1fd2fb2f0230",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {},
  // Shift-end "Still at work?" reminders (src/server.ts → src/db/reminders.ts). UTC schedule.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
